# ==========================================
# Quran Tutor — Environment Variables
# ==========================================

# Telegram Bot
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Production WebApp URL (on Railway: https://your-project.up.railway.app/)
WEBAPP_URL=http://localhost:8000/
API_BASE_URL=http://127.0.0.1:8000/api

# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=change-this-in-production-to-a-random-secret-key

# Database (Railway automatically sets DATABASE_URL if PostgreSQL is added)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ASR Microservice URL (optional)
ASR_SERVICE_URL=http://127.0.0.1:8001